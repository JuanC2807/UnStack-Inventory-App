<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6FE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/Logo"
            android:layout_width="200dp"
            android:layout_height="90dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/EditSystemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit System"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/EditSystemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add new inventory items to the system"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/ItemNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: Tomatoes"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starting Quantity"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/StartingQuantityEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: 10"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Par Level"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/ParLevelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minimum amount before low stock warning"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cost"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/CostEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: 12.99"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Existing Supplier"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/SupplierSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OR Create New Supplier"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supplier Name"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/SupplierNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: Restaurant Depot"
            android:inputType="text"
            android:layout_marginBottom="16dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supplier Address"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/SupplierAddressEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: 123 Main Street"
            android:inputType="textPostalAddress"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/AddItemButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Item"
            android:backgroundTint="#605770"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/ClearFormButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Form"
            android:backgroundTint="#605770"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/BackHomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home"
            android:backgroundTint="#605770"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>