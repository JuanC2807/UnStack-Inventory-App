<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF6FE"
    tools:context=".Home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/Logo"
            android:layout_width="200dp"
            android:layout_height="90dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/logo" />

        <LinearLayout
            android:id="@+id/editStockButton"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#605770"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/editSystemImage"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="#D9D9D9"
                android:src="@drawable/system"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/editSystemTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Edit System"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/updateStockButton"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#605770"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/updateStockImage"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="#D9D9D9"
                android:src="@drawable/updatestock"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/updateStockText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Update Stock"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ViewStockButton"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#605770"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ViewStockImage"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="#D9D9D9"
                android:src="@drawable/stock"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/viewStockText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="View Stock"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/RestockButton"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#605770"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/RestockImage"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="#D9D9D9"
                android:src="@drawable/restock"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/RestockText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Restock"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/RequestRestockButton"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#605770"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/RequestRestockImage"
                android:layout_width="90dp"
                android:layout_height="70dp"
                android:background="#D9D9D9"
                android:src="@drawable/requeststock"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/RequestRestockText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Request Restock"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/LogoutAppButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#605770"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>